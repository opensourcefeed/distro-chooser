{
  "name": "distro-chooser",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy": "bash scripts/deploy.sh",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "validate": "node scripts/validate-distros.mjs",
    "validate:questions": "node scripts/validate-questions.mjs",
    "validate:all": "node scripts/validate-distros.mjs && node scripts/validate-questions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run validate:all && pnpm test && pnpm run check && pnpm build",
    "test:e2e": "pnpm build && playwright test",
    "og:render": "node scripts/render-og-image.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.1",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
