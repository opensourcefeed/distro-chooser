---
import Layout from '../layouts/Layout.astro';
import QuizApp from '../components/QuizApp';
---

<!--
  Tradeoff: on mid-quiz reload we restart cleanly.
  We could persist answers to sessionStorage and restore on load,
  but the quiz is only 6 questions and the added complexity of
  hydrating partial state wasn't justified. If the quiz grows
  significantly, sessionStorage persistence is the recommended upgrade.

  The heading and its "quiz" vs "results" copy live inside QuizApp.tsx so
  there's exactly one <h1> at a time instead of a static one here plus a
  second heading once results are shown.
-->

<Layout>
	<main class="min-h-screen flex flex-col items-center justify-center bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-white transition-colors duration-200">
		<QuizApp client:load />
	</main>
</Layout>
