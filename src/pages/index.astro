---
import Layout from "../layouts/Layout.astro";
import QuizApp from "../components/QuizApp";
import ContentSections from "../components/ContentSections.astro";
import { faqJsonLd } from "../lib/faq";
import { distrosSchema } from "../schemas/distro";
import { questionsSchema } from "../schemas/question";
import distrosData from "../data/distros.json";
import questionsData from "../data/questions.json";

// Build-time validation: the build fails if the data doesn't match the
// schemas. This runs only on the server, so Zod never reaches the browser.
distrosSchema.parse(distrosData);
questionsSchema.parse(questionsData);
---

<!--
  The quiz has one <h1> at a time (landing, quiz or results heading), rendered
  by QuizApp. Mid-quiz reloads restart cleanly; see TODO P3-1 for
  sessionStorage persistence.
-->

<Layout structuredData={[faqJsonLd]}>
	<main id="main" class="flex-1">
		<QuizApp client:load />
		<ContentSections />
	</main>
</Layout>
