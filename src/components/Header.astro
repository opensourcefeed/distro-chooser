---
/**
 * Sticky site header: OpenSourceFeed logo + "Distro Chooser" wordmark on the
 * left; "Start over" (only while the quiz is in progress) and the theme
 * toggle on the right. Plain HTML + a tiny inline script, no framework
 * island. QuizApp announces its view with a `dc:view` window event and
 * listens for `dc:start-over`.
 */
---

<header
	id="site-header"
	class="sticky top-0 z-40 border-b border-transparent bg-canvas/80 backdrop-blur-md transition-colors duration-200 data-[scrolled]:border-line pt-[env(safe-area-inset-top)]"
>
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-[max(1rem,env(safe-area-inset-left))] sm:px-6">
		<a href="https://www.opensourcefeed.org" class="group flex min-h-11 items-center gap-2.5 rounded-lg focus-ring" aria-label="OpenSourceFeed home">
			<img src="/distro-chooser/icon-512.png" alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
			<span class="hidden text-sm font-medium text-muted transition-colors group-hover:text-fg min-[400px]:inline">OpenSourceFeed</span>
		</a>
		<span class="hidden h-5 w-px bg-line min-[400px]:block" aria-hidden="true"></span>
		<a href="/distro-chooser/" class="mr-auto min-h-11 inline-flex items-center rounded-lg font-display text-base font-semibold tracking-tight text-fg focus-ring">
			Distro Chooser
		</a>

		<button
			type="button"
			id="header-start-over"
			hidden
			class="inline-flex min-h-11 items-center gap-1.5 rounded-[var(--radius-control)] px-3 text-sm font-medium text-muted transition-colors hover:bg-surface-2 hover:text-fg focus-ring"
		>
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
			<span>Start over</span>
		</button>

		<button
			type="button"
			id="theme-toggle"
			aria-label="Switch to dark mode"
			aria-pressed="false"
			class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-line bg-surface text-fg shadow-sm transition-colors hover:bg-surface-2 focus-ring"
		>
			<svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
			<svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path></svg>
		</button>
	</div>
</header>

<script is:inline>
	(function () {
		var header = document.getElementById("site-header");
		var toggle = document.getElementById("theme-toggle");
		var startOver = document.getElementById("header-start-over");
		var root = document.documentElement;

		function syncToggle() {
			var dark = root.classList.contains("dark");
			toggle.setAttribute("aria-pressed", String(dark));
			toggle.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
		}
		syncToggle();
		toggle.addEventListener("click", function () {
			var dark = !root.classList.contains("dark");
			root.classList.toggle("dark", dark);
			try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch (e) {}
			syncToggle();
		});

		function onScroll() {
			if (window.scrollY > 4) header.setAttribute("data-scrolled", "");
			else header.removeAttribute("data-scrolled");
		}
		onScroll();
		window.addEventListener("scroll", onScroll, { passive: true });

		window.addEventListener("dc:view", function (e) {
			startOver.hidden = !(e.detail === "quiz" || e.detail === "results");
		});
		startOver.addEventListener("click", function () {
			window.dispatchEvent(new CustomEvent("dc:start-over"));
		});
	})();
</script>
