---
import { dataLastReviewed, distros, formatDate } from "../lib/data";

const year = new Date().getFullYear();
const reportUrl = "https://github.com/opensourcefeed/distro-chooser/issues/new";
---

<footer class="mt-auto border-t border-line bg-surface pb-[env(safe-area-inset-bottom)]">
	<div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
		<div class="max-w-sm">
			<p class="font-display text-lg font-semibold tracking-tight text-fg">Distro Chooser</p>
			<p class="mt-2 text-sm leading-relaxed text-muted">
				A free, independent quiz from OpenSourceFeed that matches you with a Linux distribution. It compares {distros.length} distributions using hand-reviewed data and explains every recommendation.
			</p>
			<p class="mt-4 text-sm text-muted">
				Data last reviewed: <time datetime={dataLastReviewed} class="font-medium text-fg">{formatDate(dataLastReviewed)}</time>
			</p>
		</div>

		<nav aria-label="About this tool">
			<p class="text-xs font-semibold uppercase tracking-wider text-muted">About</p>
			<ul class="mt-3 space-y-1 text-sm">
				<li><a href="/distro-chooser/#how-it-works" class="inline-flex min-h-11 items-center text-fg hover:text-accent hover:underline underline-offset-4">How it works</a></li>
				<li><a href="/distro-chooser/#methodology" class="inline-flex min-h-11 items-center text-fg hover:text-accent hover:underline underline-offset-4">How we score</a></li>
				<li><a href="/distro-chooser/#faq" class="inline-flex min-h-11 items-center text-fg hover:text-accent hover:underline underline-offset-4">FAQ</a></li>
				<li><a href="/distro-chooser/#all-distros" class="inline-flex min-h-11 items-center text-fg hover:text-accent hover:underline underline-offset-4">All distros we consider</a></li>
				<li><a href="/distro-chooser/best-for/" class="inline-flex min-h-11 items-center text-fg hover:text-accent hover:underline underline-offset-4">Best distros by need</a></li>
				<li><a href="/distro-chooser/compare/" class="inline-flex min-h-11 items-center text-fg hover:text-accent hover:underline underline-offset-4">Distro comparisons</a></li>
			</ul>
		</nav>

		<nav aria-label="OpenSourceFeed and feedback">
			<p class="text-xs font-semibold uppercase tracking-wider text-muted">More</p>
			<ul class="mt-3 space-y-1 text-sm">
				<li><a href="https://www.opensourcefeed.org" class="inline-flex min-h-11 items-center text-fg hover:text-accent hover:underline underline-offset-4">OpenSourceFeed</a></li>
				<li><a href="https://www.opensourcefeed.org/distribution/" class="inline-flex min-h-11 items-center text-fg hover:text-accent hover:underline underline-offset-4">Linux distribution guides</a></li>
				<li><a href={reportUrl} rel="noopener" class="inline-flex min-h-11 items-center text-fg hover:text-accent hover:underline underline-offset-4">Report an error</a></li>
				<li><a href="https://www.opensourcefeed.org/privacy-policy/" class="inline-flex min-h-11 items-center text-fg hover:text-accent hover:underline underline-offset-4">Privacy policy</a></li>
				<li>
					<button type="button" data-consent-settings class="inline-flex min-h-11 items-center text-fg hover:text-accent hover:underline underline-offset-4 rounded focus-ring">Cookie settings</button>
				</li>
			</ul>
		</nav>
	</div>
	<div class="border-t border-line">
		<p class="mx-auto max-w-6xl px-4 py-5 text-xs text-muted sm:px-6">
			© {year} OpenSourceFeed. Analytics (Google Analytics, Ahrefs) only run if you allow them. Distribution names are trademarks of their respective owners.
		</p>
	</div>
</footer>
