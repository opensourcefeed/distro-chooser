---
interface Props {
	items: { name: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-muted">
	<ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
		<li><a href="/distro-chooser/" class="inline-flex min-h-11 items-center hover:text-fg hover:underline underline-offset-4">Distro Chooser</a></li>
		{items.map((item) => (
			<li class="flex items-center gap-2">
				<span aria-hidden="true">/</span>
				{item.href ? (
					<a href={item.href} class="inline-flex min-h-11 items-center hover:text-fg hover:underline underline-offset-4">{item.name}</a>
				) : (
					<span aria-current="page" class="inline-flex min-h-11 items-center font-medium text-fg">{item.name}</span>
				)}
			</li>
		))}
	</ol>
</nav>
