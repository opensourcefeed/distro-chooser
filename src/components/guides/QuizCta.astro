---
interface Props {
	title?: string;
	text?: string;
}
const {
	title = "Get a recommendation for your own computer",
	text = "Guides like this one cover typical needs. The Distro Chooser quiz weighs your device, experience, hardware age, graphics card and desktop preference, and explains every match. It takes about a minute.",
} = Astro.props;
---

<aside class="my-14 overflow-hidden rounded-[var(--radius-card)] border border-brand-300/60 bg-surface shadow-[var(--shadow-card)] dark:border-brand-800">
	<div class="flex flex-col gap-5 bg-gradient-to-br from-accent-soft to-transparent p-6 sm:flex-row sm:items-center sm:p-8">
		<div class="flex-1">
			<p class="font-display text-h3 font-semibold tracking-tight">{title}</p>
			<p class="mt-2 max-w-[60ch] text-muted">{text}</p>
		</div>
		<a
			href="/distro-chooser/"
			class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-[var(--radius-control)] bg-primary px-6 font-semibold text-on-primary shadow-[var(--shadow-card)] transition-colors hover:bg-primary-hover focus-ring"
		>
			Take the quiz
			<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
		</a>
	</div>
</aside>
